{
  "name": "durable-order-system",
  "version": "1.0.0",
  "description": "Durable Order Fulfillment System - a Temporal + Fastify + PostgreSQL POC",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "dev": "concurrently -n API,WORKER -c blue,green \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/workers/order.worker.ts",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/workers/order.worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.6",
    "@temporalio/client": "^1.11.6",
    "@temporalio/worker": "^1.11.6",
    "@temporalio/workflow": "^1.11.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@temporalio/testing": "^1.23.0",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "protobufjs@8.8.0": true,
    "protobufjs@7.6.6": true
  }
}
