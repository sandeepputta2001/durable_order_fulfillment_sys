# ---------------------------------------------------------------------------
# Durable Order Fulfillment System - environment configuration
#
# Copy this file to .env for local (non-Docker) development:
#   cp .env.example .env
#
# When running via `docker compose up`, docker-compose.yml already sets the
# correct in-network hostnames (postgres, temporal) for you; this file is
# for running the API/Worker directly on the host with `npm run dev:*`.
#
# Never commit a real .env file or real secrets. This POC uses no real
# secrets (the "payment" and "notification" activities are simulated), but
# the same pattern (env-driven config, nothing hardcoded) is what you'd use
# to inject real credentials in production via your secrets manager.
# ---------------------------------------------------------------------------

# HTTP port the Fastify API listens on
PORT=8080

# Port the Worker's own Prometheus /metrics endpoint listens on (the Worker
# is a separate process from the API and tracks its own Activity/order
# outcome metrics - see docs/ARCHITECTURE.md "Observability")
WORKER_METRICS_PORT=9464

# PostgreSQL connection string used by both the API and the Worker.
# Port 5433 matches docker-compose.yml's host port mapping for postgres
# (shifted from the default 5432 to avoid clashing with a Postgres that
# may already be running on the host).
DATABASE_URL=postgres://order_user:order_pass@localhost:5433/order_system

# Temporal server connection
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-fulfillment

# Failure simulation switch for the payment activity (see docs/FAILURE_SCENARIOS.md)
PAYMENT_FAILURE_MODE=false

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
